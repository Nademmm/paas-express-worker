/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "paas-express-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 */
	"vars": {
		"APP_NAME": "PaaS Express Worker",
		"APP_ENV": "development"
	}
	/**
	 * Cloudflare D1 Database Binding (Persiapan Materi Selanjutnya)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#d1-databases
	 */
	// "d1_databases": [
	// 	{
	// 		"binding": "DB",
	// 		"database_name": "paas-express-db",
	// 		"database_id": "<YOUR_D1_DATABASE_ID>"
	// 	}
	// ]
}